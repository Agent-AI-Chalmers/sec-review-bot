# Fixed credentials for loopback-only local Memory development.
# These values are public development defaults, not secrets. Do not use this
# file on a shared machine or any deployment reachable from another host.

# POSTGRES_USER=sec_review_bot
POSTGRES_PASSWORD=sec-review-local-postgres
# Avoid colliding with a PostgreSQL instance already used for other local work.
POSTGRES_PORT=55432

# RUSTFS_ROOT_USER=sec-review-root
RUSTFS_ROOT_PASSWORD=sec-review-local-rustfs-root

# The current RustFS initializer provisions every repository storage identity.
# Local Memory uses only the execution and memory identities, but the remaining
# fixed values are still required while initializing the shared local bucket.
SEC_REVIEW_INTEGRATION_S3_ACCESS_KEY=sec-review-integration
SEC_REVIEW_INTEGRATION_S3_SECRET_KEY=sec-review-local-integration
SEC_REVIEW_EXECUTION_S3_ACCESS_KEY=sec-review-execution-worker
SEC_REVIEW_EXECUTION_S3_SECRET_KEY=sec-review-local-execution
SEC_REVIEW_MEMORY_S3_ACCESS_KEY=sec-review-memory-worker
SEC_REVIEW_MEMORY_S3_SECRET_KEY=sec-review-local-memory
SEC_REVIEW_UI_S3_ACCESS_KEY=sec-review-control-plane-ui
SEC_REVIEW_UI_S3_SECRET_KEY=sec-review-local-ui

AGENT_MEMORY_CATALOG_TOKEN=sec-review-local-catalog
AGENT_MEMORY_CATALOG_URL=http://127.0.0.1:8092

# Compose interpolation placeholders.
# These services are not started by the local Memory command. Their fixed
# placeholders are present only because Compose interpolates the shared file
# before filtering the explicitly selected services.
EXECUTION_API_TOKEN=unused-local-execution-api
REVIEW_RUNS_SERVICE_TOKEN=unused-local-review-runs-service
REVIEW_RUNS_READ_TOKEN=unused-local-review-runs-read
CONTROL_PLANE_UI_ACCESS_TOKEN=unused-control-plane-ui

# Artifact storage used by host workers. Local RustFS has no bucket DNS, so it
# uses path addressing; external storage can use auto or virtual addressing.
SEC_REVIEW_ARTIFACT_S3_BUCKET=sec-review
SEC_REVIEW_ARTIFACT_S3_ENDPOINT=http://127.0.0.1:9100
SEC_REVIEW_ARTIFACT_S3_ADDRESSING_STYLE=path
AWS_REGION=us-east-1

# Temporal worker connection and concurrency.
TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_EXECUTION_TASK_QUEUE=sec-review-execution
# TEMPORAL_EXECUTION_MAX_CONCURRENT_ACTIVITIES=2
# TEMPORAL_MEMORY_EXTRACTION_MAX_CONCURRENT_ACTIVITIES=4
# TEMPORAL_MEMORY_MAINTENANCE_MAX_CONCURRENT_ACTIVITIES=1

# Loopback host ports.
# RUSTFS_API_PORT=9100
# RUSTFS_CONSOLE_PORT=9101
# MEMORY_CATALOG_HOST_PORT=8092
# TEMPORAL_PORT=7233
# TEMPORAL_UI_PORT=8233
