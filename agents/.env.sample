# This file is the agents-side process env sample. Docker Compose also reads it,
# but compose.yaml overrides some deployment paths and service settings.
#
# Agents use config/model-providers.toml here by default.
# Set this only when using a different TOML file.
# MODEL_PROVIDERS_CONFIG_TOML="/absolute/path/to/model-providers.toml"

# Extra retries when a structured-output agent finishes without structured_response.
AGENT_MISSING_STRUCTURED_RESPONSE_MAX_RETRIES=2

LANGFUSE_PUBLIC_KEY="xx-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_SECRET_KEY="xx-xx-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
LANGFUSE_BASE_URL="http://localhost:3000"

AGENT_LOG_LEVEL="INFO"
AGENT_SANDBOX_BACKEND="docker"
AGENT_DOCKER_NETWORK_MODE="none"
AGENT_DISCOVERY_MAX_FILE_BYTES="262144"

# Memory source directory. Usually worth setting for a real local setup.
# AGENT_MEMORY_DIR="/absolute/path/to/sec-review-agents-memory"
# AGENT_MEMORY_MATERIALIZED_ROOT="/tmp/sec-review-agents-memory"

# Runner-owned artifact base directory.
SEC_REVIEW_AGENT_ARTIFACT_ROOT=".sec-review-agent-artifacts"

# Built-in defaults are 1. Uncomment when tuning repository runs.
# AGENT_DISCOVERY_MAX_CONCURRENCY=8
# AGENT_CASE_PROCESSING_MAX_CONCURRENCY=6
REPOSITORY_PATCH_SYNTHESIS_MAX_CONCURRENCY=4
