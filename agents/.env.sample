# This file configures locally invoked agents and host execution workers.
# Docker Compose control-plane services do not read it.
#
# Agents use config/model-providers.toml here by default.
# Set this only when using a different TOML file.
# MODEL_PROVIDERS_CONFIG_TOML="/absolute/path/to/model-providers.toml"

# Extra retries when a structured-output agent finishes without structured_response.
AGENT_MISSING_STRUCTURED_RESPONSE_MAX_RETRIES=2

# Optional Langfuse tracing. Uncomment only after creating a valid Langfuse
# project and replacing all three values with matching credentials.
# LANGFUSE_PUBLIC_KEY="your_langfuse_public_key"
# LANGFUSE_SECRET_KEY="your_langfuse_secret_key"
# LANGFUSE_BASE_URL="http://localhost:3000"

AGENT_LOG_LEVEL="INFO"
# Execution workers should fail visibly when Docker is unavailable. Local run
# commands may override this when intentionally testing another backend.
AGENT_SANDBOX_BACKEND="docker"
AGENT_DOCKER_NETWORK_MODE="none"
# Optional CodeGraph-enabled Docker sandbox. Build it first from the repository root:
# docker build -f agents/docker/workspace-codegraph.Dockerfile -t sec-review-bot-workspace:codegraph agents
# AGENT_DOCKER_IMAGE="sec-review-bot-workspace:codegraph"
# AGENT_MCP_ENABLED="true"
# Optional discovery resource controls. Defaults are 262144 bytes and
# single-file chunking; leave commented unless overriding worker defaults.
# AGENT_DISCOVERY_MAX_FILE_BYTES="262144"
# AGENT_DISCOVERY_CHUNK_STRATEGY="single-file"

# Memory source directory. Usually worth setting for a real local setup.
# AGENT_MEMORY_DIR="/absolute/path/to/sec-review-bot/.agent-memory"
# AGENT_MEMORY_MATERIALIZED_ROOT="/tmp/.agent-memory-materialized"

# Optional runner filesystem boundaries for a manually started worker or replay.
# Use absolute paths. Local run commands manage their own per-run directories.
# SEC_REVIEW_AGENT_INPUT_BUNDLE_ROOT="/absolute/path/to/sec-review-bot/.agent-input-bundles"
# SEC_REVIEW_AGENT_ARTIFACT_ROOT="/absolute/path/to/sec-review-bot/.agent-artifacts"

# Temporal activity concurrency for each host worker process.
# TEMPORAL_MAX_CONCURRENT_ACTIVITIES=2

# Discovery and case-processing concurrency each default to 1.
# Uncomment these settings when tuning repository runs.
# AGENT_DISCOVERY_MAX_CONCURRENCY=8
# AGENT_CASE_PROCESSING_MAX_CONCURRENCY=6
REPOSITORY_PATCH_SYNTHESIS_MAX_CONCURRENCY=4
