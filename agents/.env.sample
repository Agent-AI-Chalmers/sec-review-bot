# This file configures locally invoked agents and host execution workers.
# Docker Compose review-runs services do not read it.
#
# Agents use config/model-providers.toml here by default.
# Set this only when using a different TOML file.
# MODEL_PROVIDERS_CONFIG_TOML="/absolute/path/to/model-providers.toml"

# Extra retries when a structured-output agent finishes without
# structured_response. Defaults to 2.
# AGENT_MISSING_STRUCTURED_RESPONSE_MAX_RETRIES=2

# Optional Langfuse tracing. Uncomment only after creating a valid Langfuse
# project and replacing all three values with matching credentials.
# LANGFUSE_PUBLIC_KEY="your_langfuse_public_key"
# LANGFUSE_SECRET_KEY="your_langfuse_secret_key"
# LANGFUSE_BASE_URL="http://localhost:3000"

# Logging defaults to INFO.
# AGENT_LOG_LEVEL="INFO"

# Execution-capable agents use Docker by default and run without network access.
# Override the backend only when intentionally using bwrap.
# AGENT_SANDBOX_BACKEND="docker"
# AGENT_DOCKER_NETWORK_MODE="none"

# Docker and bwrap commands use a 10-minute timeout.
# AGENT_COMMAND_TIMEOUT_MS="600000"

# Optional workspace-tools Docker sandbox. Build it first from the repository root:
# docker build -f agents/docker/workspace-tools.Dockerfile -t sec-review-bot-workspace:tools agents
# AGENT_DOCKER_IMAGE="sec-review-bot-workspace:tools"

# Bundled skills are enabled by default.
# AGENT_SKILLS_ENABLED="true"

# Optional external CLI prompts are disabled by default.
# AGENT_JOERN_ENABLED="false"
# AGENT_PLAYWRIGHT_ENABLED="false"

# Optional MCP integrations are disabled by default.
# AGENT_MCP_ENABLED="false"

# Optional memory features.
# AGENT_MEMORY_CONSUMPTION_ENABLED="true"
# AGENT_MEMORY_PROCESSING_ENABLED="true"

# S3 transport for host workers. AWS can omit the endpoint and keep auto
# addressing. The local RustFS deployment supplies its endpoint and uses path
# addressing because it has no bucket DNS. Credentials use the standard AWS
# environment variables or the role-specific systemd deployment settings.
# SEC_REVIEW_ARTIFACT_S3_BUCKET="sec-review"
# SEC_REVIEW_ARTIFACT_S3_ENDPOINT="http://127.0.0.1:9100"
# SEC_REVIEW_ARTIFACT_S3_ADDRESSING_STYLE="path"
# AWS_REGION="us-east-1"

# Upper bound (seconds) the runner applies to each setup-declaration step
# timeout (`.sec-review/setup.yml`), and to repository-provided declarations.
# Defaults to 600; raise it for repositories whose dependency installs are slow.
# SEC_REVIEW_SETUP_STEP_MAX_SECONDS="600"

# Optional discovery resource controls. Defaults are 262144 bytes and
# single-file chunking; leave commented unless overriding worker defaults.
# AGENT_DISCOVERY_MAX_FILE_BYTES="262144"
# AGENT_DISCOVERY_CHUNK_STRATEGY="single-file"

# Optional runner filesystem boundaries for a manually started worker or replay.
# Use absolute paths. Local run commands manage their own per-run directories.
# SEC_REVIEW_AGENT_INPUT_BUNDLE_ROOT="/absolute/path/to/sec-review-bot/.agent-input-bundles"
# SEC_REVIEW_AGENT_ARTIFACT_ROOT="/absolute/path/to/sec-review-bot/.agent-artifacts"

# Temporal activity concurrency for each host worker process.
# TEMPORAL_EXECUTION_MAX_CONCURRENT_ACTIVITIES=2

# Discovery and case-processing concurrency each default to 1.
# Uncomment these settings when tuning repository runs.
# AGENT_DISCOVERY_MAX_CONCURRENCY=8
# AGENT_CASE_PROCESSING_MAX_CONCURRENCY=6
# REPOSITORY_PATCH_SYNTHESIS_MAX_CONCURRENCY=4
