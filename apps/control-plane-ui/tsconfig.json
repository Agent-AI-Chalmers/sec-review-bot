{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "browser",
    "shared",
    "scripts",
    "test/components",
    "test/e2e",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
