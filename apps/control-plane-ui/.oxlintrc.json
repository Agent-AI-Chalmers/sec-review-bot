{
  "ignorePatterns": [
    "dist/**",
    "dist-server/**",
    "node_modules/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "globals": {
        "console": "readonly",
        "document": "readonly",
        "fetch": "readonly",
        "window": "readonly",
        "Buffer": "readonly",
        "process": "readonly",
        "URL": "readonly"
      }
    }
  ],
  "extends": ["../../.oxlintrc.json"]
}
