{
  "name": "@sec-review-bot/control-plane-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "CONTROL_PLANE_UI_DEV_FIXTURES=1 vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "server": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@tabler/icons-react": "3.49.0",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "^6.0.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.11.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript-eslint": "latest"
  }
}
