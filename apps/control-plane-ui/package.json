{
  "name": "@sec-review-bot/control-plane-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "CONTROL_PLANE_UI_DEV_FIXTURES=1 vite",
    "build": "rm -rf dist-server && vite build && tsc -p tsconfig.server.build.json",
    "server": "node dist-server/server/main.js",
    "typecheck": "tsc --noEmit && pnpm run test:types",
    "test": "vitest run --project logic --project components",
    "test:logic": "vitest run --project logic",
    "test:component": "vitest run --project components",
    "test:e2e": "playwright test",
    "test:e2e:update-visuals": "playwright test test/e2e/visual.spec.ts --update-snapshots",
    "colors:check": "tsx scripts/check-colors.ts",
    "icons:check": "tsx scripts/check-icons.ts",
    "styles:report": "tsx scripts/report-style-literals.ts",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:affected": "vitest run --project logic --project components --since-last-run=true",
    "test:types": "vitest run --project types",
    "test:browser-component": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tabler/icons-react": "3.50.0",
    "@vitejs/plugin-react": "6.2.1",
    "codemirror": "^6.0.2",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-json-tree": "0.20.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "^4.0.1",
    "tar-stream": "^3.2.2",
    "typescript": "^6.0.3",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@vitest/browser-playwright": "5.1.0",
    "colorjs.io": "^0.7.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tsx": "^4.23.15",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
