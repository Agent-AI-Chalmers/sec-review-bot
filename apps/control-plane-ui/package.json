{
  "name": "@sec-review-bot/control-plane-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "CONTROL_PLANE_UI_DEV_FIXTURES=1 vite",
    "build": "vite build && tsc -p tsconfig.server.build.json",
    "server": "node dist-server/server/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "pnpm run test:node && pnpm run test:component",
    "test:node": "node --import tsx --test test/*.test.ts",
    "test:component": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:update-visuals": "playwright test test/e2e/visual.spec.ts --update-snapshots",
    "colors:check": "tsx scripts/check-colors.ts",
    "icons:check": "tsx scripts/check-icons.ts",
    "styles:report": "tsx scripts/report-style-literals.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tabler/icons-react": "3.50.0",
    "@vitejs/plugin-react": "6.1.2",
    "codemirror": "^6.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-json-tree": "0.20.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4",
    "remark-gfm": "^4.0.1",
    "tar-stream": "^3.2.2",
    "typescript": "^6.0.3",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-stream": "^3.1.5",
    "colorjs.io": "^0.7.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
