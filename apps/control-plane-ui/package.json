{
  "name": "@sec-review-bot/control-plane-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "CONTROL_PLANE_UI_DEV_FIXTURES=1 vite",
    "build": "vite build && tsc -p tsconfig.server.build.json",
    "server": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:smoke": "node test/browser-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.71.2"
  }
}
