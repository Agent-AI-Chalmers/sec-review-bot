{
  "name": "@sec-review-bot/github-integration",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "server": "pnpm run build && node dist/app.js",
    "dev": "pnpm run build && sh -c 'tsc -w -p tsconfig.json & TSC_PID=$!; trap \"kill $TSC_PID\" EXIT INT TERM; nodemon --watch dist --ext js,json --delay 200ms --exec \"node dist/app.js\"'",
    "test": "rm -rf dist && node scripts/test-runner.mjs unit",
    "test:integration": "node scripts/test-runner.mjs integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm run test:types",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:types": "vitest run --project types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@octokit/webhooks": "^14.2.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "jose": "^6.2.15",
    "octokit": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aws-sdk-client-mock": "^4.1.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
