{
  "name": "@sec-review-bot/github-integration",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "server": "pnpm run build && node dist/app.js",
    "dev": "tsx watch --clear-screen=false src/app.ts",
    "test": "rm -rf dist && node scripts/test-runner.mjs unit",
    "test:integration": "node scripts/test-runner.mjs integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm run test:types",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:types": "vitest run --project types"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@octokit/webhooks": "^14.2.0",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.10",
    "jose": "^6.2.18",
    "octokit": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "aws-sdk-client-mock": "^4.1.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
