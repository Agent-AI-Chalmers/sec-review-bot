# Required GitHub App identity and webhook authentication.
APP_ID="123456"

# Used only when starting GitHub Integration outside Docker Compose. Prefer an
# absolute path so the App does not depend on the process working directory.
# Compose mounts GITHUB_APP_PRIVATE_KEY_FILE and overrides this value with the
# resulting container path.
PRIVATE_KEY_PATH="/absolute/path/to/private-key.pem"
WEBHOOK_SECRET="your_webhook_secret"

# HTTP server. Defaults to 30000.
# PORT="30000"

# Optional dispatch hard limits. Keep these low enough that dispatch authentication
# cannot be used as an unbounded body sink.
# SEC_BOT_DISPATCH_MAX_BODY_BYTES="1048576"
# SEC_BOT_DISPATCH_READ_TIMEOUT_MS="10000"

# Review Runs endpoint for running GitHub integration outside Compose.
# Compose overrides this with the service-network address.
REVIEW_RUNS_SERVICE_URL="http://127.0.0.1:8090"
REVIEW_RUNS_SERVICE_TOKEN="dev-review-runs-token"

# Publication polling defaults to 15 seconds.
# REVIEW_RUNS_PUBLICATION_POLL_INTERVAL_MS="15000"

# Bound every admission, heartbeat, and publication RPC. A timed-out lease
# renewal makes publication ownership untrusted and stops new GitHub mutations.
# Defaults to 30 seconds.
# REVIEW_RUNS_REQUEST_TIMEOUT_MS="30000"

# Optional proxy used only by git fetch while materializing review workspaces.
# GITHUB_INTEGRATION_GIT_HTTP_PROXY="http://127.0.0.1:7897"

# Bound every git subprocess (fetch, checkout, gc, snapshot tar) so a hung
# remote cannot stall input preparation forever. Defaults to 600000 ms; raise it
# for repositories whose cold clone legitimately takes longer.
# GITHUB_INTEGRATION_GIT_TIMEOUT_MS="600000"

# Input bundles are assembled in a local staging directory before publication.
# Override the process-relative default only when staging must use another disk.
# SEC_REVIEW_INPUT_BUNDLE_ROOT="/absolute/path/to/input-bundle-staging"

# Publish input bundles to S3 instead of retaining file:// references. AWS can
# omit the endpoint and keep auto addressing. The local RustFS deployment sets
# its endpoint and uses path addressing because it has no bucket DNS.
# SEC_REVIEW_ARTIFACT_STORE="s3"
# SEC_REVIEW_ARTIFACT_S3_BUCKET="sec-review"
# SEC_REVIEW_ARTIFACT_S3_ENDPOINT="http://127.0.0.1:9100"
# SEC_REVIEW_ARTIFACT_S3_ADDRESSING_STYLE="path"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="replace-me"
# AWS_SECRET_ACCESS_KEY="replace-me"
