APP_ID="123456"
# Prefer an absolute path here so local runs do not depend on which directory
# launches the App process.
# Docker Compose overrides this to /run/secrets/github-app-private-key.pem.
PRIVATE_KEY_PATH="/absolute/path/to/private-key.pem"
WEBHOOK_SECRET="your_webhook_secret"
PORT="30000"

# Optional dispatch hard limits. Keep these low enough that dispatch authentication
# cannot be used as an unbounded body sink.
SEC_BOT_DISPATCH_MAX_BODY_BYTES="1048576"
SEC_BOT_DISPATCH_READ_TIMEOUT_MS="10000"

AGENT_RUNNER_SERVICE_URL="http://127.0.0.1:8000"
AGENT_RUNNER_SERVICE_TOKEN="dev-token"
# Optional runner HTTP client bounds for submit/status calls.
AGENT_RUNNER_SERVICE_REQUEST_TIMEOUT_MS="30000"
AGENT_RUNNER_SERVICE_REQUEST_RETRIES="2"
AGENT_RUNNER_SERVICE_RETRY_BASE_DELAY_MS="500"
AGENT_RUNNER_BACKGROUND_POLL_INTERVAL_MS="15000"
# Prefer absolute paths for local App state so they stay unambiguous across
# different entrypoints.
SEC_REVIEW_INPUT_BUNDLE_ROOT="/absolute/path/to/.agent-input-bundles"
SEC_REVIEW_APP_STATE_ROOT="/absolute/path/to/.agent-app-state"
