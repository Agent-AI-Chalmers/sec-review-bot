{
  "name": "@sec-review-bot/execution-gateway",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "copy:spec": "cp ../contracts/execution-api/v1/openapi.yaml dist/openapi.yaml",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run copy:spec",
    "server": "pnpm run build && node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && NODE_ENV=test node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@platformatic/fastify-openapi-glue": "^5.2.0",
    "@temporalio/client": "^1.14.0",
    "ajv": "^8.20.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
