# Copy to .env before running docker compose if you want to override defaults.

# Credentials. Generate each secret independently with `openssl rand -hex 32`; never reuse
# one value for two roles. Each answers a different question - who may open the console, what
# the console reads with, which services may coordinate, and who may decide on a stuck run:

# 1. Who may open the console. The browser exchanges this for an HTTP-only session cookie;
#    the token itself never reaches browser code.
CONTROL_PLANE_UI_ACCESS_TOKEN=

# 2. What the console backend uses to read Review Runs on a signed-in user's behalf.
#    A different value from the one above, so a console account and a read key can be
#    issued, rotated, and revoked separately.
REVIEW_RUNS_READ_TOKEN=

# 3. Which service may coordinate runs. Held by GitHub integration for admission,
#    claims, and terminal outcomes; it cannot reach /v1/admin.
REVIEW_RUNS_SERVICE_TOKEN=

# 4. Which component may submit work through the Execution API.
EXECUTION_API_TOKEN=

# 5. Which host workers may coordinate memory extraction and maintenance.
#    The Memory Catalog Server alone receives PostgreSQL credentials.
AGENT_MEMORY_CATALOG_TOKEN=

# 6. Which operator-facing service may pause, edit, restore, and resume memory.
AGENT_MEMORY_CATALOG_OPERATOR_TOKEN=

# 7. Who may act on a run an operator has to decide about. Optional: leaving it empty is
#    the same as not setting it, and every /v1/admin route then answers 404 instead of
#    existing behind a token nobody rotates. Read-only consumers (monitoring, dashboards)
#    use the read token above and never need this one.
REVIEW_RUNS_ADMIN_TOKEN=

# Optional external Langfuse project used for execution-statistics reconciliation.
# Set all three values together to enable it; leaving all three empty keeps statistics disabled.
# These credentials stay in Review Runs and are never sent to the Control Plane browser.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional reconciliation tuning. Successful reads reset the consecutive-failure count.
EXECUTION_STATISTICS_MAX_ITEMS_PER_PASS=20
EXECUTION_STATISTICS_MAX_FAILURES=8

# PostgreSQL
# POSTGRES_USER=sec_review_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
REVIEW_RUNS_POSTGRES_PASSWORD=replace-with-a-long-random-review-runs-password
MEMORY_CATALOG_POSTGRES_PASSWORD=replace-with-a-long-random-memory-catalog-password

# RustFS administration and workload identities
RUSTFS_ROOT_PASSWORD=replace-with-a-long-random-root-password
SEC_REVIEW_INTEGRATION_S3_SECRET_KEY=replace-with-a-long-random-integration-password
SEC_REVIEW_EXECUTION_S3_SECRET_KEY=replace-with-a-long-random-execution-password
SEC_REVIEW_MEMORY_S3_SECRET_KEY=replace-with-a-long-random-memory-password
SEC_REVIEW_UI_S3_SECRET_KEY=replace-with-a-long-random-ui-reader-password

# Host ports
# PostgreSQL commonly already occupies 5432 on development machines. Choose another
# host port, such as 55432, when running this stack alongside an existing instance.
# POSTGRES_PORT=5432
# RUSTFS_API_PORT=9100
# RUSTFS_CONSOLE_PORT=9101
# EXECUTION_GATEWAY_PORT=8000
# REVIEW_RUNS_HOST_PORT=8090
# CONTROL_PLANE_UI_HOST_PORT=8091
# MEMORY_CATALOG_HOST_PORT=8092

# Temporal
# TEMPORAL_NAMESPACE=default
# TEMPORAL_EXECUTION_TASK_QUEUE=sec-review-execution

# Temporal gRPC is exposed on loopback for host execution workers.
# TEMPORAL_PORT=7233
# TEMPORAL_UI_PORT=8233

# Maximum execution workflow duration. The GitHub integration background publisher keeps
# polling completed/failed state; its polling interval is configured separately.
# TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=10800

# GitHub Integration (only needed when starting the app profile)
# GITHUB_INTEGRATION_HOST_PORT=30000

# Optional build-time npm registry for Node service dependencies. This does not change where
# Docker pulls the pnpm base image; configure the Docker daemon separately for a GHCR mirror.
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Host path mounted into the GitHub Integration container as a Compose secret.
# Relative paths are resolved from the Compose project directory.
# GITHUB_APP_PRIVATE_KEY_FILE=./apps/github-integration/private-key.pem

# Background polling intervals.
# AGENT_EXECUTION_BACKGROUND_POLL_INTERVAL_MS=15000
# REVIEW_RUNS_PUBLICATION_POLL_INTERVAL_MS=15000

# Optional proxy used only by git fetch while materializing review workspaces.
# The proxy must be reachable from the container; this host name is provided by Compose.
# GITHUB_INTEGRATION_GIT_HTTP_PROXY=http://host.docker.internal:7897

# Configure models, artifacts, concurrency, tracing, memory, and sandboxes in
# the host worker environment.
