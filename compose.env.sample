# Copy to .env before running docker compose if you want to override defaults.

# Required. Generate a local secret, for example: openssl rand -hex 32
RUNNER_SERVICE_TOKEN=
RUNNER_SERVICE_PORT=8000
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sec-review-agents
TEMPORAL_UI_PORT=8233
TEMPORAL_ACTIVITY_WORKERS=8
# Maximum runner workflow duration. The GitHub integration background publisher keeps
# polling completed/failed state; its polling interval is configured separately.
TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=10800

# Runner-owned artifact base directory. Each run writes to
# ${SEC_REVIEW_AGENT_ARTIFACT_ROOT}/<run_id>. Keep this separate from input
# materials so inputs and runner outputs have independent lifecycles.
SEC_REVIEW_AGENT_ARTIFACT_ROOT=${PWD}/.agent-artifacts

# Compose mounts this file into runner-service / runner-worker as
# /run/secrets/model-providers.toml.
MODEL_PROVIDERS_CONFIG_TOML_FILE=./agents/config/model-providers.toml

# Only needed when starting the app profile.
GITHUB_INTEGRATION_HOST_PORT=30000
# Optional build-time npm registry for the GitHub integration image. The default is
# the public npm registry; use a reachable mirror when that endpoint is unreliable.
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
GITHUB_APP_PRIVATE_KEY_FILE=./apps/github-integration/private-key.pem
AGENT_RUNNER_BACKGROUND_POLL_INTERVAL_MS=15000

# GitHub integration writes runner input bundles here. Compose mounts this path into the
# app and worker containers so the runner can read the bundle by file:// path.
SEC_REVIEW_INPUT_BUNDLE_ROOT=${PWD}/.agent-input-bundles

# GitHub integration owned state. The background runner publisher stores submitted runs
# here so completed long-running reviews can still be published after an App
# restart.
SEC_REVIEW_APP_STATE_ROOT=${PWD}/.agent-app-state

# Docker socket based sandboxing needs input bundle and artifact paths that also
# exist on the host. Run docker compose from the repository root so these paths
# are the same in the GitHub integration container, runner worker container, and host
# Docker daemon.
#
# Current Compose intentionally runs app / worker / sandbox as root. That keeps
# the service chain simple while the HTTP runner and Temporal path are still being
# stabilized. The tradeoff is that local bundle / artifact directories may
# contain root-owned files.

# auto uses Docker sandbox when the worker container can reach Docker.
# Set to local to force filesystem fallback.
AGENT_SANDBOX_BACKEND=auto
