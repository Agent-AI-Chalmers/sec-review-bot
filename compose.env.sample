# Copy to .env before running docker compose if you want to override defaults.

# Required. Generate a local secret, for example: openssl rand -hex 32
RUNNER_SERVICE_TOKEN=
POSTGRES_DB=sec_review_bot
POSTGRES_USER=sec_review_bot
POSTGRES_PASSWORD=replace-with-a-long-random-password
RUSTFS_ROOT_PASSWORD=replace-with-a-long-random-root-password
SEC_REVIEW_INTEGRATION_S3_SECRET_KEY=replace-with-a-long-random-integration-password
SEC_REVIEW_RUNNER_S3_SECRET_KEY=replace-with-a-long-random-runner-password
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUNNER_SERVICE_PORT=8000
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sec-review-agents
# Temporal gRPC is exposed on loopback for host execution workers.
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
# Maximum runner workflow duration. The GitHub integration background publisher keeps
# polling completed/failed state; its polling interval is configured separately.
TEMPORAL_WORKFLOW_TIMEOUT_SECONDS=10800

# Only needed when starting the app profile.
GITHUB_INTEGRATION_HOST_PORT=30000
# Optional build-time npm registry for the GitHub integration image. The default is
# the public npm registry; use a reachable mirror when that endpoint is unreliable.
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
GITHUB_APP_PRIVATE_KEY_FILE=./apps/github-integration/private-key.pem
AGENT_RUNNER_BACKGROUND_POLL_INTERVAL_MS=15000
# Optional proxy used only by git fetch while materializing review workspaces.
# The proxy must be reachable from the container; this host name is provided by Compose.
# GITHUB_INTEGRATION_GIT_HTTP_PROXY=http://host.docker.internal:7897

# Configure models, artifacts, concurrency, tracing, memory, and sandboxes in
# the host worker environment.
