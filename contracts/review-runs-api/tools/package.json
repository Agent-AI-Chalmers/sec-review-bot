{
  "name": "@sec-review-bot/review-runs-api-tools",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "generate": "node --import tsx src/generate.ts",
    "check": "node --import tsx src/check.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "lint:contract": "spectral lint ../v1/openapi.yaml --ruleset ../../.spectral.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sec-review-bot/contract-codegen": "workspace:*",
    "@stoplight/spectral-cli": "^6.17.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
