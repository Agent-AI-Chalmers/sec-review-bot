{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/control-plane-api/v1/review-run-record.schema.json",
  "type": "object",
  "required": [
    "run_id",
    "workflow",
    "publish_context",
    "runner_status",
    "publication_status",
    "created_at",
    "execution_updated_at",
    "publication_updated_at",
    "published_at",
    "failure_code",
    "failure_message",
    "artifact_storage"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "anyOf": [
        {
          "type": "string",
          "const": "issue-review"
        },
        {
          "type": "string",
          "const": "pull-request-review"
        },
        {
          "type": "string",
          "const": "repository-review"
        }
      ]
    },
    "publish_context": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "runner_input": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    },
    "ingress_kind": {
      "anyOf": [
        {
          "type": "string",
          "const": "github_webhook"
        },
        {
          "type": "string",
          "const": "github_actions_dispatch"
        }
      ]
    },
    "ingress_key": {
      "type": "string"
    },
    "runner_status": {
      "anyOf": [
        {
          "type": "string",
          "const": "preparing"
        },
        {
          "type": "string",
          "const": "recovering"
        },
        {
          "type": "string",
          "const": "queued"
        },
        {
          "type": "string",
          "const": "running"
        },
        {
          "type": "string",
          "const": "succeeded"
        },
        {
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "publication_status": {
      "anyOf": [
        {
          "type": "string",
          "const": "pending"
        },
        {
          "type": "string",
          "const": "publishing"
        },
        {
          "type": "string",
          "const": "published"
        },
        {
          "type": "string",
          "const": "failed"
        },
        {
          "type": "string",
          "const": "skipped"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_storage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "unavailable"
                },
                {
                  "type": "string",
                  "const": "failed"
                }
              ]
            },
            "error_code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "artifact"
          ],
          "properties": {
            "status": {
              "type": "string",
              "const": "available"
            },
            "artifact": {
              "type": "object",
              "required": [
                "kind",
                "uri",
                "media_type",
                "digest",
                "size_bytes"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "diagnostic_bundle"
                },
                "uri": {
                  "type": "string",
                  "pattern": "^s3://sec-review/runs/[^/]+/artifacts/diagnostic-tree\\.v1\\.tar\\.zst$"
                },
                "media_type": {
                  "type": "string",
                  "const": "application/tar+zstd"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
