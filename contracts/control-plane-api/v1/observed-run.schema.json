{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/control-plane-api/v1/observed-run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "workflow",
    "preparation",
    "execution_status",
    "submitted_at",
    "publication_status",
    "created_at",
    "execution_updated_at",
    "publication_updated_at",
    "published_at",
    "failure_code",
    "artifact_storage"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "enum": [
        "issue-review",
        "pull-request-review",
        "repository-review"
      ]
    },
    "preparation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Durable preparation state, when the run has a preparation record. This is an operational summary only; it never exposes connector-owned preparation input.",
      "additionalProperties": false,
      "required": [
        "status",
        "attempt_count",
        "updated_at",
        "failure_code",
        "failure_notice_status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "Preparation lifecycle. `preparing` means a preparer currently owns the claim; it is the preparation axis's own \"in progress\" state and is unrelated to the Runner, which is only submitted to once preparation reaches `submitted`.",
          "enum": [
            "pending",
            "preparing",
            "submitted",
            "failed"
          ]
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "failure_notice_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            "delivering",
            "delivered",
            "skipped",
            null
          ]
        }
      }
    },
    "execution_status": {
      "type": "string",
      "description": "The Runner lifecycle, retained under its established public name. `pending` means the run has been admitted but its prepared input has not yet been submitted to the Runner; preparation progress is reported separately by `preparation`. `skipped` means execution never ran because preparation failed; the reason is on `preparation`, not here. `uncertain` means a submission may have reached the Runner but its result could not be confirmed; a recovery replays it to resolve the run to `queued` or `failed`, so it is not a failure.",
      "enum": [
        "pending",
        "queued",
        "running",
        "uncertain",
        "succeeded",
        "skipped",
        "failed"
      ]
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Immutable instant execution began (the prepared input was accepted and the run entered queued). NULL while the run is still preparing; use it, not execution_updated_at, to time execution."
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "pending",
        "publishing",
        "published",
        "failed",
        "skipped"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failure_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "unavailable",
                "failed"
              ]
            },
            "error_code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "artifact"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available"
              ]
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "uri",
                "media_type",
                "digest",
                "size_bytes"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "diagnostic_bundle"
                  ]
                },
                "uri": {
                  "type": "string",
                  "pattern": "^s3://sec-review/runs/[^/]+/artifacts/diagnostic-tree\\.v1\\.tar\\.zst$"
                },
                "media_type": {
                  "type": "string",
                  "enum": [
                    "application/tar+zstd"
                  ]
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
