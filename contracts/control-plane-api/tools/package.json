{
  "name": "@sec-review-bot/contract-tools-control-plane-api",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node --import tsx src/generate.ts",
    "check": "node --import tsx src/check-generated-artifacts.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:contract": "spectral lint ../openapi.yaml --ruleset ../../.spectral.yaml",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@stoplight/spectral-cli": "^6.17.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
