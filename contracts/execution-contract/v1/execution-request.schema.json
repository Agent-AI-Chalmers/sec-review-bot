{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/execution-contract/v1/execution-request.schema.json",
  "title": "ExecutionRequest",
  "x-temporal-workflow-type": "execution-workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["workflow", "run_id", "input_data", "timeout_seconds"],
  "properties": {
    "workflow": {
      "type": "string",
      "enum": ["issue-review", "pull-request-review", "repository-review"]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "input_data": { "type": "object" },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "runtime": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace_image": { "type": "string", "pattern": "\\S" }
          }
        }
      ]
    }
  }
}
