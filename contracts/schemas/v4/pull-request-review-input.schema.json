{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/schemas/v4/pull-request-review-input.schema.json",
  "title": "Contract v4 pull-request-review input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input_bundle_uri",
    "review_intent",
    "pr"
  ],
  "allOf": [
    {
      "properties": {
        "review_intent": {
          "type": "object",
          "properties": {
            "objective": {
              "const": "audit"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "contract_version": {
      "const": "v4"
    },
    "input_bundle_uri": {
      "type": "string",
      "minLength": 1
    },
    "review_intent": {
      "$ref": "common.schema.json#/$defs/reviewIntent"
    },
    "pr": {
      "type": "object"
    }
  }
}
