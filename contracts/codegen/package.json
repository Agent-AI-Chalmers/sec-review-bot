{
  "name": "@sec-review-bot/contract-codegen",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "check": "pnpm run typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kubb/core": "5.25.1",
    "@kubb/plugin-ts": "5.7.3",
    "kubb": "5.25.1",
    "oxfmt": "0.80.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  }
}
