{
  "name": "@sec-review-bot/execution-api-tools",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "generate": "node --import tsx src/generate.ts",
    "check": "node --import tsx src/check.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:contract": "spectral lint ../v1/openapi.yaml --ruleset ../../.spectral.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@kubb/core": "5.13.1",
    "@kubb/plugin-ts": "5.1.0",
    "@stoplight/spectral-cli": "^6.17.0",
    "json-schema-to-typescript": "16.0.0",
    "kubb": "5.13.1",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "rollup": "4.52.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
