{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/execution-api/v1/schemas/issue-review-input.schema.json",
  "title": "Execution API v1 issue-review input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "input_bundle",
    "review_intent",
    "issue"
  ],
  "properties": {
    "api_version": {
      "const": "v1"
    },
    "input_bundle": {
      "$ref": "common.schema.json#/$defs/inputBundleArtifactRef"
    },
    "review_intent": {
      "$ref": "common.schema.json#/$defs/reviewIntent"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repo",
        "repo_full_name",
        "number",
        "title",
        "body"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "repo_full_name": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "setup_declaration": {
      "$ref": "common.schema.json#/$defs/setupDeclarationText"
    }
  }
}
