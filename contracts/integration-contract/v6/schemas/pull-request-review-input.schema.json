{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/integration-contract/v6/schemas/pull-request-review-input.schema.json",
  "title": "Contract v6 pull-request-review input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input_bundle",
    "review_intent",
    "pr"
  ],
  "allOf": [
    {
      "properties": {
        "review_intent": {
          "type": "object",
          "properties": {
            "objective": {
              "const": "audit"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "contract_version": {
      "const": "v6"
    },
    "input_bundle": {
      "$ref": "common.schema.json#/$defs/inputBundleArtifactRef"
    },
    "review_intent": {
      "$ref": "common.schema.json#/$defs/reviewIntent"
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "repo",
        "repo_full_name",
        "number",
        "title",
        "body",
        "base_ref",
        "base_sha",
        "head_ref",
        "head_sha",
        "commit_shas",
        "review_window"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "repo_full_name": {
          "type": "string"
        },
        "number": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_ref": {
          "type": "string"
        },
        "base_sha": {
          "type": "string"
        },
        "head_ref": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "commit_shas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20000,
          "$comment": "Bounded because the list is inlined into the workflow input. A pull request's commits are paginated, so nothing else limits this."
        },
        "review_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base_sha",
            "head_sha",
            "reason"
          ],
          "properties": {
            "kind": {
              "enum": [
                "full",
                "push"
              ]
            },
            "base_sha": {
              "type": "string"
            },
            "head_sha": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "setup_declaration": {
      "$ref": "common.schema.json#/$defs/setupDeclarationText"
    }
  }
}
