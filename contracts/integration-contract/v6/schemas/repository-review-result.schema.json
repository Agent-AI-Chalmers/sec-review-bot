{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/integration-contract/v6/schemas/repository-review-result.schema.json",
  "title": "Contract v6 repository-review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scan_summary",
    "case_results",
    "deliveries",
    "deletion_review_skipped"
  ],
  "properties": {
    "contract_version": {
      "const": "v6"
    },
    "scan_summary": {
      "$ref": "common.schema.json#/$defs/scanSummary"
    },
    "case_results": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/repositoryCaseResult"
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/repositoryDelivery"
      }
    },
    "deletion_review_skipped": {
      "$comment": "True when the window removed more files than deletion review covers, so none of its deletions were reviewed. Required so a consumer can never mistake an unreviewed window for an ordinary success. The count itself is scan_summary.deleted_file_count.",
      "type": "boolean"
    }
  }
}
