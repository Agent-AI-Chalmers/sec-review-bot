{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/integration-contract/v5/schemas/pull-request-review-input.schema.json",
  "title": "Contract v5 pull-request-review input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input_bundle",
    "review_intent",
    "pr"
  ],
  "allOf": [
    {
      "properties": {
        "review_intent": {
          "type": "object",
          "properties": {
            "objective": {
              "const": "audit"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "contract_version": {
      "const": "v5"
    },
    "input_bundle": {
      "$ref": "common.schema.json#/$defs/inputBundleArtifactRef"
    },
    "review_intent": {
      "$ref": "common.schema.json#/$defs/reviewIntent"
    },
    "pr": {
      "type": "object"
    }
  }
}
