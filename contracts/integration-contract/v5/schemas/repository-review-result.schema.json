{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/contracts/integration-contract/v5/schemas/repository-review-result.schema.json",
  "title": "Contract v5 repository-review result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scan_summary",
    "case_results",
    "deliveries"
  ],
  "properties": {
    "contract_version": {
      "const": "v5"
    },
    "scan_summary": {
      "$ref": "common.schema.json#/$defs/scanSummary"
    },
    "case_results": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/repositoryCaseResult"
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/repositoryDelivery"
      }
    }
  }
}
