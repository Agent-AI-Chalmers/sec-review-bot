{
  "$comment": "Every artifact generated from this family's contract, with the file that renders it and the contract it derives from. Paths are relative to the repository root. The tool's test asserts this matches the generator's own declared outputs and that CI triggers on each. Regenerate with: pnpm --dir contracts/integration-contract/tools run generate",
  "family": "integration-contract",
  "generators": [
    {
      "name": "types",
      "script": "contracts/integration-contract/tools/src/generate-types.ts",
      "code_inputs": [
        "contracts/integration-contract/tools/src/generate-integration-types.ts",
        "control-plane/.prettierrc.json",
        "execution-gateway/.prettierrc.json"
      ],
      "command": "pnpm --dir contracts/integration-contract/tools run generate",
      "inputs": [
        "contracts/integration-contract/openapi.yaml",
        "contracts/integration-contract/v6/schemas/issue-review-input.schema.json",
        "contracts/integration-contract/v6/schemas/pull-request-review-input.schema.json",
        "contracts/integration-contract/v6/schemas/repository-review-input.schema.json",
        "contracts/integration-contract/v6/schemas/common.schema.json"
      ],
      "outputs": [
        "control-plane/src/execution-api-schema.ts",
        "execution-gateway/src/contract-types-generated.ts"
      ]
    },
    {
      "name": "integration-types",
      "script": "contracts/integration-contract/tools/src/generate-integration-types.ts",
      "code_inputs": ["apps/github-integration/.prettierrc.json"],
      "command": "pnpm --dir contracts/integration-contract/tools run generate",
      "inputs": [
        "contracts/integration-contract/v6/schemas/issue-review-input.schema.json",
        "contracts/integration-contract/v6/schemas/pull-request-review-input.schema.json",
        "contracts/integration-contract/v6/schemas/repository-review-input.schema.json",
        "contracts/integration-contract/v6/schemas/review-record.schema.json",
        "contracts/integration-contract/v6/schemas/common.schema.json"
      ],
      "outputs": [
        "apps/github-integration/src/execution/integration-contract-types-generated.ts",
        "execution-gateway/src/contract-version.ts",
        "apps/github-integration/src/execution/contract-version.ts"
      ]
    }
  ]
}
