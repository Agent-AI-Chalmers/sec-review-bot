{
  "$comment": "Every artifact generated from this family's contract. Paths are relative to the repository root.",
  "family": "memory-catalog-api",
  "generators": [
    {
      "name": "types",
      "script": "contracts/memory-catalog-api/tools/src/generate.ts",
      "command": "pnpm --dir contracts/memory-catalog-api/tools run generate",
      "inputs": ["contracts/memory-catalog-api/v1/openapi.yaml"],
      "outputs": [
        "services/memory-catalog/src/contract-types-generated.ts",
        "apps/control-plane-ui/browser/features/memory/api-types.generated.ts"
      ]
    }
  ]
}
