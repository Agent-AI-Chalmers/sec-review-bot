{
  "$comment": "Every artifact generated from a hand-written contract, with the script that renders it and the contract it derives from. Paths are relative to the repository root. This is the single source for 'what is generated and where'; the generators' own staleness tests assert it matches what they actually write, and CI derives its change filters from it.",
  "generators": [
    {
      "name": "control-plane-types",
      "script": "control-plane/scripts/generate-control-plane-types.ts",
      "command": "pnpm --dir control-plane run generate:control-plane-types",
      "inputs": ["contracts/control-plane-api/openapi.yaml"],
      "outputs": [
        "control-plane/src/contract-types-generated.ts",
        "control-plane/src/error-codes-generated.ts",
        "apps/github-integration/src/control-plane/control-plane-api.ts",
        "apps/control-plane-ui/src/list-run-query-params.ts"
      ]
    },
    {
      "name": "control-plane-schemas",
      "script": "control-plane/scripts/generate-control-plane-schemas.ts",
      "command": "pnpm --dir control-plane run generate:control-plane-schemas",
      "inputs": ["contracts/control-plane-api/openapi.yaml"],
      "outputs": [
        "contracts/control-plane-api/v1/observed-run.schema.json",
        "contracts/control-plane-api/v1/review-run-record.schema.json"
      ]
    },
    {
      "name": "runner-api-types",
      "script": "control-plane/scripts/generate-runner-api-types.ts",
      "command": "pnpm --dir control-plane run generate:runner-api",
      "inputs": ["contracts/integration-contract/openapi.json"],
      "outputs": ["control-plane/src/runner-api-schema.ts"]
    }
  ]
}
