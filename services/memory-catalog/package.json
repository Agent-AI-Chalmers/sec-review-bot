{
  "name": "@sec-review-bot/memory-catalog",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "copy:schema": "mkdir -p dist/database && cp -R src/database/schema-versions dist/database/",
    "copy:spec": "cp ../../contracts/memory-catalog-api/v1/openapi.yaml dist/openapi.yaml",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run copy:schema && pnpm run copy:spec",
    "server": "pnpm run build && node dist/server.js",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && vitest run --project unit",
    "test:integration": "node --import tsx scripts/postgres-integration-test-launcher.ts",
    "test:dev": "vitest run --project unit"
  },
  "dependencies": {
    "@platformatic/fastify-openapi-glue": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "^2.9.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007"
  }
}
