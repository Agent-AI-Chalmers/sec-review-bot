{
  "name": "@sec-review-bot/control-plane",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "copy:schema": "mkdir -p dist/database && cp -R src/database/schema-versions dist/database/",
    "copy:spec": "node --import tsx scripts/copy-contract.ts",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run copy:schema && pnpm run copy:spec",
    "server": "pnpm run build && node dist/server.js",
    "test": "pnpm run build && node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx scripts/postgres-integration-test-launcher.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@platformatic/fastify-openapi-glue": "^5.2.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
