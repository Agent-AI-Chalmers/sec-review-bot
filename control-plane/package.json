{
  "name": "@sec-review-bot/control-plane",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "generate:runner-api": "node --import tsx scripts/generate-runner-api-types.ts",
    "copy:schema": "mkdir -p dist/database && cp -R src/database/schema-versions dist/database/",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run copy:schema",
    "server": "pnpm run build && node dist/server.js",
    "test": "pnpm run build && node --import tsx --test test/*.test.ts",
    "test:integration": "pnpm run build && node --import tsx --test test/integration/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
