{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sec-review-bot.local/schemas/observed-run.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "workflow",
    "status",
    "created_at",
    "updated_at",
    "published_at",
    "failure_code",
    "artifact_publication"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "workflow": { "enum": ["issue-review", "pull-request-review", "repository-review"] },
    "status": {
      "enum": [
        "preparing",
        "recovering",
        "queued",
        "running",
        "succeeded",
        "publishing",
        "published",
        "failed"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "failure_code": { "type": ["string", "null"] },
    "artifact_publication": { "type": ["object", "null"] },
    "publication_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_key", "status", "failure_count", "failure_code"],
        "properties": {
          "step_key": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["pending", "running", "succeeded", "failed", "terminal_failed"]
          },
          "failure_count": { "type": "integer", "minimum": 0 },
          "failure_code": { "type": ["string", "null"] }
        }
      }
    }
  }
}
