{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::sec-review/runs/*/artifacts/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::sec-review/memory/trees/*",
        "arn:aws:s3:::sec-review/memory/trajectories/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::sec-review"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["memory/trees/*", "memory/trajectories/*"]
        }
      }
    }
  ]
}
