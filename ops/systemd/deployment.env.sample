# Optional worker paths. Omit these overrides to use the current checkout.
# MODEL_PROVIDERS_CONFIG_TOML=/absolute/path/to/model-providers.toml
# SEC_REVIEW_AGENT_ARTIFACT_ROOT=/absolute/path/to/artifacts
# SEC_REVIEW_AGENT_RUN_INPUT_ROOT=/absolute/path/to/materialized-run-inputs

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sec-review-agents
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=2

# Read-only input artifact access for the host Temporal worker.
SEC_REVIEW_ARTIFACT_S3_BUCKET=sec-review
SEC_REVIEW_ARTIFACT_S3_ENDPOINT=http://127.0.0.1:9100
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sec-review-runner
AWS_SECRET_ACCESS_KEY=change-this-runner-storage-password

# Read-only terminal artifact access for the Control Plane UI BFF.
SEC_REVIEW_UI_S3_ACCESS_KEY=sec-review-ui-artifact-reader
SEC_REVIEW_UI_S3_SECRET_KEY=change-this-ui-storage-password

# PostgreSQL used by the GitHub integration coordination store and Compose.
POSTGRES_DB=sec_review_bot
POSTGRES_USER=sec_review_bot
# The Postgres password must be set in the project `.env`, NOT here. The systemd
# unit exports this file into the `docker compose` process environment, where it
# takes precedence over `.env`; shipping a concrete placeholder here used to
# shadow the operator's `.env` password and leave the data volume unauthenticated
# against a later foreground compose run.
# POSTGRES_PASSWORD=

AGENT_SANDBOX_BACKEND=docker
AGENT_DOCKER_BIN=docker
AGENT_DOCKER_NETWORK_MODE=none
AGENT_DOCKER_IMAGE=mcr.microsoft.com/devcontainers/universal:6-noble
AGENT_JOERN_ENABLED=false
AGENT_PLAYWRIGHT_ENABLED=false
AGENT_MCP_ENABLED=false

# Optional memory store.
# AGENT_MEMORY_DIR=/absolute/path/to/sec-review-bot/.agent-memory

# Optional Langfuse tracing. Set all three values together.
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_BASE_URL=http://localhost:3000
