# Shared source configuration for the local systemd deployment. The installer
# combines this file with checkout-derived paths and writes the result to
# /etc/sec-review-bot/deployment.env. Each service receives the shared file but
# reads only the settings it owns.

# Checkout-derived paths. Leave these commented to use the current checkout.
# MODEL_PROVIDERS_CONFIG_TOML=/absolute/path/to/model-providers.toml
# SEC_REVIEW_AGENT_ARTIFACT_ROOT=/absolute/path/to/artifacts
# SEC_REVIEW_AGENT_RUN_INPUT_ROOT=/absolute/path/to/materialized-run-inputs

# Temporal connection shared by all host workers.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default

# Object-storage endpoint shared by the execution and memory workers. Each
# worker exports its own role credential as the standard AWS credential pair.
# Local RustFS uses path addressing because this deployment has no bucket DNS;
# external storage can omit the endpoint and use auto or virtual addressing.
SEC_REVIEW_ARTIFACT_S3_BUCKET=sec-review
SEC_REVIEW_ARTIFACT_S3_ENDPOINT=http://127.0.0.1:9100
SEC_REVIEW_ARTIFACT_S3_ADDRESSING_STYLE=path
AWS_REGION=us-east-1

# Execution Worker scheduling. The task queue must match the Execution Gateway
# setting used by the Compose services.
TEMPORAL_EXECUTION_TASK_QUEUE=sec-review-execution
# TEMPORAL_EXECUTION_MAX_CONCURRENT_ACTIVITIES=2

# Execution Worker object-storage identity.
SEC_REVIEW_EXECUTION_S3_ACCESS_KEY=sec-review-execution-worker
SEC_REVIEW_EXECUTION_S3_SECRET_KEY=change-this-execution-worker-storage-password

# Execution Worker agent runtime. Review agents use Docker without network
# access by default.
# AGENT_SANDBOX_BACKEND=docker
# AGENT_DOCKER_BIN=docker
# AGENT_DOCKER_NETWORK_MODE=none
# AGENT_DOCKER_IMAGE=sec-review-bot-workspace:tools

# Memory Extraction Worker scheduling. Its task queue is fixed by the systemd
# unit.
# TEMPORAL_MEMORY_EXTRACTION_MAX_CONCURRENT_ACTIVITIES=4

# Memory Maintenance Worker scheduling. Its task queue and activity concurrency
# are fixed by the systemd unit. Concurrency cannot exceed 1, which enforces the
# single-maintainer deployment.

# Memory worker object-storage identity. Extraction and maintenance currently
# share the memory artifact namespace and therefore use the same role.
SEC_REVIEW_MEMORY_S3_ACCESS_KEY=sec-review-memory-worker
SEC_REVIEW_MEMORY_S3_SECRET_KEY=change-this-memory-worker-storage-password

# Memory worker Catalog access. Both workers use this narrow service credential;
# PostgreSQL credentials remain confined to the Catalog container.
AGENT_MEMORY_CATALOG_URL=http://127.0.0.1:8092
AGENT_MEMORY_CATALOG_TOKEN=change-this-memory-catalog-token

# Memory behavior defaults to enabled for the execution and memory workers.
# AGENT_MEMORY_CONSUMPTION_ENABLED=true
# AGENT_MEMORY_PROCESSING_ENABLED=true

# Agent capabilities shared by the host workers. Bundled skills are enabled;
# external CLI prompts and optional MCP integrations are disabled by default.
# AGENT_SKILLS_ENABLED=true
# AGENT_JOERN_ENABLED=false
# AGENT_PLAYWRIGHT_ENABLED=false
# AGENT_MCP_ENABLED=false

# Optional Langfuse tracing for agent invocations. Set all three values
# together after creating a Langfuse project.
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_BASE_URL=http://localhost:3000

# Control Plane UI BFF read-only access to stored run artifacts.
SEC_REVIEW_UI_S3_ACCESS_KEY=sec-review-ui-artifact-reader
SEC_REVIEW_UI_S3_SECRET_KEY=change-this-ui-storage-password

# Compose configuration such as PostgreSQL credentials belongs in the project
# .env. Do not repeat it here: this file is exported into the Compose process
# and would take precedence over the project .env.
