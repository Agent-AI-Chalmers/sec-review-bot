[Unit]
Description=Sec Review execution worker %i
Requires=sec-review-bot-control-plane.service
After=sec-review-bot-control-plane.service
PartOf=sec-review-bot.target sec-review-bot-control-plane.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@SEC_REVIEW_BOT_USER@
Environment=TEMPORAL_ADDRESS=127.0.0.1:7233
Environment=TEMPORAL_NAMESPACE=default
Environment=TEMPORAL_EXECUTION_TASK_QUEUE=sec-review-execution
Environment=TEMPORAL_EXECUTION_MAX_CONCURRENT_ACTIVITIES=2
Environment=AGENT_SANDBOX_BACKEND=docker
Environment=AGENT_DOCKER_BIN=docker
EnvironmentFile=/etc/sec-review-bot/deployment.env
ExecStartPre=/usr/bin/env docker info
ExecStartPre=/bin/sh -c 'test -n "$SEC_REVIEW_EXECUTION_S3_ACCESS_KEY" -a -n "$SEC_REVIEW_EXECUTION_S3_SECRET_KEY"'
ExecStart=/bin/sh -c 'export AWS_ACCESS_KEY_ID="$SEC_REVIEW_EXECUTION_S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$SEC_REVIEW_EXECUTION_S3_SECRET_KEY"; cd "$SEC_REVIEW_AGENTS_DIR" && exec .venv/bin/sec-review-execution-worker'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s

[Install]
WantedBy=sec-review-bot.target
