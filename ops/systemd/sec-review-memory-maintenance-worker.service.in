[Unit]
Description=Sec Review memory maintenance worker
Requires=sec-review-bot-compose-stack.service
After=sec-review-bot-compose-stack.service
PartOf=sec-review-bot.target sec-review-bot-compose-stack.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=@SEC_REVIEW_BOT_USER@

Environment=TEMPORAL_ADDRESS=127.0.0.1:7233
Environment=TEMPORAL_NAMESPACE=default
Environment=TEMPORAL_MEMORY_MAINTENANCE_TASK_QUEUE=sec-review-memory-maintenance
EnvironmentFile=/etc/sec-review-bot/memory-worker.env
Environment=TEMPORAL_MEMORY_MAINTENANCE_MAX_CONCURRENT_ACTIVITIES=1

ExecStartPre=/bin/sh -c 'test "$TEMPORAL_MEMORY_MAINTENANCE_MAX_CONCURRENT_ACTIVITIES" = 1'
ExecStartPre=/bin/sh -c 'test -n "$AGENT_MEMORY_CATALOG_URL" -a -n "$AGENT_MEMORY_CATALOG_TOKEN"'
ExecStartPre=/bin/sh -c 'test -n "$SEC_REVIEW_ARTIFACT_S3_BUCKET" -a -n "$SEC_REVIEW_ARTIFACT_S3_ENDPOINT"'
ExecStartPre=/bin/sh -c 'test -n "$SEC_REVIEW_MEMORY_S3_ACCESS_KEY" -a -n "$SEC_REVIEW_MEMORY_S3_SECRET_KEY"'

ExecStart=/bin/sh -c 'export AWS_ACCESS_KEY_ID="$SEC_REVIEW_MEMORY_S3_ACCESS_KEY" AWS_SECRET_ACCESS_KEY="$SEC_REVIEW_MEMORY_S3_SECRET_KEY"; cd "$SEC_REVIEW_AGENTS_DIR" && exec .venv/bin/sec-review-memory-maintenance-worker'

Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s

[Install]
WantedBy=sec-review-bot.target
