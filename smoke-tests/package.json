{
  "name": "@sec-review-bot/smoke-tests",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings --type-aware",
    "test:smoke": "bash run.sh",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
