{
  "name": "@sec-review-bot/smoke-tests",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "test:smoke": "bash run.sh",
    "format": "oxfmt --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
