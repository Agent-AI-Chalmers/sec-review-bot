[Unit]
Description=Sec Review Agents execution worker %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=TEMPORAL_ADDRESS=127.0.0.1:7233
Environment=TEMPORAL_NAMESPACE=default
Environment=TEMPORAL_TASK_QUEUE=sec-review-agents
Environment=TEMPORAL_ACTIVITY_WORKERS=2
Environment=AGENT_SANDBOX_BACKEND=docker
Environment=AGENT_DOCKER_BIN=docker
EnvironmentFile=%h/.config/sec-review-bot/worker.env
ExecStartPre=/usr/bin/env docker info
ExecStart=/bin/sh -c 'cd "$SEC_REVIEW_AGENTS_DIR" && exec .venv/bin/sec-review-agents-worker'
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s

[Install]
WantedBy=default.target
