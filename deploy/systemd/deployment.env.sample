# systemd environment files do not perform shell expansion. Use absolute paths.
SEC_REVIEW_BOT_DIR=/absolute/path/to/sec-review-bot
SEC_REVIEW_AGENTS_DIR=/absolute/path/to/sec-review-bot/agents
MODEL_PROVIDERS_CONFIG_TOML=/absolute/path/to/sec-review-bot/agents/config/model-providers.toml
SEC_REVIEW_AGENT_INPUT_BUNDLE_ROOT=/absolute/path/to/sec-review-bot/.agent-input-bundles
SEC_REVIEW_AGENT_ARTIFACT_ROOT=/absolute/path/to/sec-review-bot/.agent-artifacts

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sec-review-agents
TEMPORAL_ACTIVITY_WORKERS=2

AGENT_SANDBOX_BACKEND=docker
AGENT_DOCKER_BIN=docker
AGENT_DOCKER_NETWORK_MODE=none
AGENT_DOCKER_IMAGE=mcr.microsoft.com/devcontainers/universal:6-noble
AGENT_MCP_ENABLED=false

# Optional memory store.
# AGENT_MEMORY_DIR=/absolute/path/to/sec-review-agents-memory

# Optional Langfuse tracing. Set all three values together.
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_BASE_URL=http://localhost:3000
